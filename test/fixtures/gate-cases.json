{
  "$comment": [
    "The Bash gate's case corpus. Every historical bypass is one row here, so",
    "closing a hole means adding a line rather than remembering to write a test.",
    "Run by test/unit/gate-cases.test.js through evaluateCommand + ",
    "evaluateBashProtected, in the same order src/hooks.js applies them.",
    "",
    "Commands are templates: {NAME} expands from `placeholders` below, whose",
    "parts are concatenated with no separator (each part carries its own",
    "spacing). That indirection is not decoration \u2014 this repo's own",
    "PreToolUse hook gates writes whose content contains destructive commands,",
    "so a fixture spelling them literally could not be written from a session.",
    "",
    "`expect` is the decision the gate must reach: allow | ask | deny.",
    "`note` says what the row is defending. Keep it short and concrete.",
    "",
    "Rows in `knownLimits` document what the gate does NOT catch. They assert",
    "the current behavior on purpose: if one starts failing, the limit was",
    "closed \u2014 move the row into `cases` and update the docs that describe it."
  ],
  "placeholders": {
    "RM_ROOT": [
      "rm ",
      "-rf ",
      "/"
    ],
    "RM_FR": [
      "rm ",
      "-fr ",
      "/"
    ],
    "RM_GLOB": [
      "rm ",
      "-rf ",
      "/*"
    ],
    "RM_HOME": [
      "rm ",
      "-r ",
      "-f ",
      "~"
    ],
    "FORCE": [
      "--for",
      "ce"
    ],
    "HARD": [
      "--ha",
      "rd"
    ]
  },
  "cases": [
    {
      "command": "{RM_ROOT}",
      "expect": "deny",
      "note": "the canonical accident"
    },
    {
      "command": "sudo {RM_FR}",
      "expect": "deny",
      "note": "-fr is the same flags in the other order"
    },
    {
      "command": "{RM_GLOB}",
      "expect": "deny",
      "note": "the glob form empties root just as thoroughly"
    },
    {
      "command": "{RM_HOME}",
      "expect": "deny",
      "note": "separated flags, home directory"
    },
    {
      "command": "git push {FORCE} origin main",
      "expect": "deny",
      "note": "force-push over shared history"
    },
    {
      "command": "git -C . push {FORCE} origin main",
      "expect": "deny",
      "note": "git -C is not a hiding place"
    },
    {
      "command": "nice {RM_HOME}",
      "expect": "deny",
      "note": "wrapper: nice ran as an unknown program"
    },
    {
      "command": "nice -n 10 {RM_ROOT}",
      "expect": "deny",
      "note": "wrapper flags with a value"
    },
    {
      "command": "timeout 30 {RM_ROOT}",
      "expect": "deny",
      "note": "timeout puts a DURATION where the program goes"
    },
    {
      "command": "timeout -k 5 30 {RM_ROOT}",
      "expect": "deny",
      "note": "timeout: flag value AND duration operand"
    },
    {
      "command": "doas {RM_ROOT}",
      "expect": "deny",
      "note": "the BSD sudo"
    },
    {
      "command": "doas -u root {RM_ROOT}",
      "expect": "deny",
      "note": "doas with its own flags"
    },
    {
      "command": "setsid {RM_ROOT}",
      "expect": "deny",
      "note": "new session, same delete"
    },
    {
      "command": "busybox rm -rf /tmp/x /",
      "expect": "deny",
      "note": "applet name is the real program"
    },
    {
      "command": "command {RM_ROOT}",
      "expect": "deny",
      "note": "the shell builtin that runs the next word"
    },
    {
      "command": "sudo -E {RM_ROOT}",
      "expect": "deny",
      "note": "sudo's own flags sit before the program"
    },
    {
      "command": "eval \"{RM_ROOT}\"",
      "expect": "deny",
      "note": "eval's arguments are a command line"
    },
    {
      "command": "eval \"git push {FORCE}\"",
      "expect": "deny",
      "note": "quote-stripping erased the evidence"
    },
    {
      "command": "eval \"eval \\\"{RM_ROOT}\\\"\"",
      "expect": "deny",
      "note": "nested eval with escaped quotes"
    },
    {
      "command": "bash -c \"{RM_ROOT}\"",
      "expect": "deny",
      "note": "-c is eval wearing a different flag"
    },
    {
      "command": "sh -c '{RM_ROOT}'",
      "expect": "deny",
      "note": "single-quoted payload"
    },
    {
      "command": "zsh -lc \"{RM_ROOT}\"",
      "expect": "deny",
      "note": "clustered flags still carry a payload"
    },
    {
      "command": "timeout 30 bash -c \"{RM_ROOT}\"",
      "expect": "deny",
      "note": "wrapper and payload compose"
    },
    {
      "command": "bash -c \"eval '{RM_ROOT}'\"",
      "expect": "deny",
      "note": "payload containing another payload"
    },
    {
      "command": "npm test && {RM_ROOT}",
      "expect": "deny",
      "note": "the worst verdict in a chain wins"
    },
    {
      "command": "echo $({RM_ROOT})",
      "expect": "deny",
      "note": "substitution opens a command position"
    },
    {
      "command": "git push origin main",
      "expect": "ask",
      "note": "publishing is a human decision"
    },
    {
      "command": "git -C . push origin main",
      "expect": "ask",
      "note": "the evasive spelling is still a push"
    },
    {
      "command": "timeout 10 git push origin main",
      "expect": "ask",
      "note": "wrapped push keeps the bare verdict"
    },
    {
      "command": "git push {FORCE}-with-lease origin main",
      "expect": "ask",
      "note": "the safe force-push is gated, not denied"
    },
    {
      "command": "./deploy prod",
      "expect": "ask",
      "note": "deploys are gated by name"
    },
    {
      "command": "git reset {HARD}",
      "expect": "ask",
      "note": "working-tree guard: the accident that happens"
    },
    {
      "command": "git clean -fdx",
      "expect": "ask",
      "note": "removes untracked work"
    },
    {
      "command": "git checkout -- .",
      "expect": "ask",
      "note": "restore-over-everything"
    },
    {
      "command": "git checkout .",
      "expect": "ask",
      "note": "same, without the separator"
    },
    {
      "command": "git restore src/",
      "expect": "ask",
      "note": "restore discards a directory"
    },
    {
      "command": "git switch --discard-changes main",
      "expect": "ask",
      "note": "switch can discard too"
    },
    {
      "command": "git branch -D feat",
      "expect": "ask",
      "note": "force-delete a branch"
    },
    {
      "command": "git branch -Df feat",
      "expect": "ask",
      "note": "clustered force-delete"
    },
    {
      "command": "git stash drop",
      "expect": "ask",
      "note": "stash entries are work"
    },
    {
      "command": "git stash -q drop",
      "expect": "ask",
      "note": "a flag between the words"
    },
    {
      "command": "git rm -r src/",
      "expect": "ask",
      "note": "recursive tracked delete"
    },
    {
      "command": "git rm -f x",
      "expect": "ask",
      "note": "forced tracked delete"
    },
    {
      "command": "git worktree remove --force wt",
      "expect": "ask",
      "note": "forced worktree removal"
    },
    {
      "command": "git submodule deinit -f mod",
      "expect": "ask",
      "note": "forced deinit drops submodule work"
    },
    {
      "command": "git reset --merge",
      "expect": "ask",
      "note": "reset --merge discards too"
    },
    {
      "command": "npm test && git checkout -- .",
      "expect": "ask",
      "note": "hiding behind a harmless first command"
    },
    {
      "command": "git -C . reset {HARD}",
      "expect": "ask",
      "note": "git -C with a destructive subcommand"
    },
    {
      "command": "sudo git -C /repo clean -fdx",
      "expect": "ask",
      "note": "sudo + -C + clean"
    },
    {
      "command": "FOO=1 env git clean -f",
      "expect": "ask",
      "note": "env assignment prefix is not the program"
    },
    {
      "command": "sudo -E git reset {HARD}",
      "expect": "ask",
      "note": "sudo flags before a destructive git"
    },
    {
      "command": "sudo -u root git clean -fd",
      "expect": "ask",
      "note": "sudo -u takes a value"
    },
    {
      "command": "sudo -i git clean -fdx",
      "expect": "ask",
      "note": "sudo -i takes none"
    },
    {
      "command": "env -u FOO git reset {HARD}",
      "expect": "ask",
      "note": "env -u takes a value"
    },
    {
      "command": "time -p git clean -f",
      "expect": "ask",
      "note": "time's own flag"
    },
    {
      "command": "xargs -n 1 git checkout --",
      "expect": "ask",
      "note": "xargs -n takes a value"
    },
    {
      "command": "nohup git reset --merge",
      "expect": "ask",
      "note": "nohup is transparent"
    },
    {
      "command": "stdbuf -o0 git clean -fdx",
      "expect": "ask",
      "note": "stdbuf: value attached to the flag"
    },
    {
      "command": "stdbuf -o 0 git reset {HARD}",
      "expect": "ask",
      "note": "stdbuf: value as the next token"
    },
    {
      "command": "setsid git reset {HARD}",
      "expect": "ask",
      "note": "setsid is transparent"
    },
    {
      "command": "setsid -w git clean -fd",
      "expect": "ask",
      "note": "setsid with a flag"
    },
    {
      "command": "doas -u root git reset {HARD}",
      "expect": "ask",
      "note": "doas + destructive git"
    },
    {
      "command": "bash -lc \"git reset {HARD}\"",
      "expect": "ask",
      "note": "payload inherits the ask tier"
    },
    {
      "command": "zsh -c \"git push origin main\"",
      "expect": "ask",
      "note": "-c payload, gated tier"
    },
    {
      "command": "git checkout src/app.js",
      "expect": "ask",
      "note": "the ref names a file that exists \u2192 restore"
    },
    {
      "command": "git checkout HEAD src/app.js",
      "expect": "ask",
      "note": "explicit tree-ish plus path"
    },
    {
      "command": "git checkout Makefile",
      "expect": "ask",
      "note": "a path with no slash is still a path"
    },
    {
      "command": "git checkout src",
      "expect": "ask",
      "note": "a directory that exists"
    },
    {
      "command": "git checkout HEAD src/app.js 2>&1",
      "expect": "ask",
      "note": "redirects are not operands"
    },
    {
      "command": "echo \"git push {FORCE}\"",
      "expect": "ask",
      "note": "mentioning is gated, never denied"
    },
    {
      "command": "git config core.hooksPath /tmp/hooks",
      "expect": "ask",
      "note": "rewiring hooks disarms the gate"
    },
    {
      "command": "git -c core.hooksPath=/tmp/x push",
      "expect": "ask",
      "note": "per-command rewire, no `config` token"
    },
    {
      "command": "echo {} > .claude/settings.json",
      "expect": "ask",
      "note": "AOS cannot be used to disarm AOS"
    },
    {
      "command": "cp x .git/hooks/pre-commit",
      "expect": "ask",
      "note": "git hooks are protected"
    },
    {
      "command": "echo x > {AOS_HOME}/projects/demo/policy.yaml",
      "expect": "ask",
      "note": "the policy protects itself"
    },
    {
      "command": "git checkout -- .claude/settings.json",
      "expect": "ask",
      "note": "destructive git counts as a write"
    },
    {
      "command": "gsed -i s/a/b/ .claude/settings.json",
      "expect": "ask",
      "note": "Homebrew GNU spelling"
    },
    {
      "command": "busybox sed -i s/a/b/ .claude/settings.json",
      "expect": "ask",
      "note": "busybox applet writes too"
    },
    {
      "command": "gcp evil .claude/settings.json",
      "expect": "ask",
      "note": "gcp is cp"
    },
    {
      "command": "ls -la",
      "expect": "allow",
      "note": "the common case must stay silent"
    },
    {
      "command": "npm test",
      "expect": "allow",
      "note": "running tests is not a decision"
    },
    {
      "command": "git status",
      "expect": "allow",
      "note": "reads are free"
    },
    {
      "command": "git diff HEAD",
      "expect": "allow",
      "note": "reads are free"
    },
    {
      "command": "git stash",
      "expect": "allow",
      "note": "stashing creates, it does not destroy"
    },
    {
      "command": "git stash push",
      "expect": "allow",
      "note": "`stash push` is not `push`"
    },
    {
      "command": "git checkout main",
      "expect": "allow",
      "note": "a branch switch is not a restore"
    },
    {
      "command": "git checkout -b feature",
      "expect": "allow",
      "note": "creating a branch"
    },
    {
      "command": "git checkout -b feature main",
      "expect": "allow",
      "note": "branch from a start point"
    },
    {
      "command": "git checkout @{-1}",
      "expect": "allow",
      "note": "the previous branch"
    },
    {
      "command": "git checkout feature/login",
      "expect": "allow",
      "note": "a slash does not make it a path"
    },
    {
      "command": "git checkout release/2.0.1",
      "expect": "allow",
      "note": "nor does a version-shaped name"
    },
    {
      "command": "git checkout fix/typo.md",
      "expect": "allow",
      "note": "a branch may look exactly like a file"
    },
    {
      "command": "git checkout deleted-file.js",
      "expect": "allow",
      "note": "nothing on disk \u2192 it is a ref"
    },
    {
      "command": "git checkout v1.0.0",
      "expect": "allow",
      "note": "a tag name is a ref, not a path"
    },
    {
      "command": "git checkout main 2>&1",
      "expect": "allow",
      "note": "a redirect is not a second operand"
    },
    {
      "command": "git checkout main >/dev/null",
      "expect": "allow",
      "note": "same, other direction"
    },
    {
      "command": "git checkout -q main >/dev/null 2>&1",
      "expect": "allow",
      "note": "flags plus two redirects"
    },
    {
      "command": "git restore --staged file.js",
      "expect": "allow",
      "note": "unstaging touches no working file"
    },
    {
      "command": "git reset --soft HEAD~1",
      "expect": "allow",
      "note": "soft reset keeps the tree"
    },
    {
      "command": "git rm file.txt",
      "expect": "allow",
      "note": "a plain tracked delete is reviewable"
    },
    {
      "command": "git rm --cached -r x",
      "expect": "allow",
      "note": "--cached leaves the file on disk"
    },
    {
      "command": "git worktree remove wt",
      "expect": "allow",
      "note": "unforced removal refuses on dirty"
    },
    {
      "command": "git -c user.email=a@b.c commit -m x",
      "expect": "allow",
      "note": "ordinary -c is not a rewire"
    },
    {
      "command": "cat notes-about-git-reset{HARD}.md",
      "expect": "allow",
      "note": "a filename is not a command"
    },
    {
      "command": "cat docs/deploy.md",
      "expect": "allow",
      "note": "reading about deploys is not deploying"
    },
    {
      "command": "grep -i settings .claude/settings.json",
      "expect": "allow",
      "note": "grep does not write"
    },
    {
      "command": "gh pr view 1",
      "expect": "allow",
      "note": "not every g-name is a GNU alias"
    },
    {
      "command": "echo hello > scratch.txt",
      "expect": "allow",
      "note": "ordinary writes are not gated"
    },
    {
      "command": "nice ls",
      "expect": "allow",
      "note": "wrapper tables must not gate the harmless"
    },
    {
      "command": "timeout 30 ls",
      "expect": "allow",
      "note": "duration operand skipped correctly"
    },
    {
      "command": "timeout 30 npm test",
      "expect": "allow",
      "note": "the most common wrapped command there is"
    },
    {
      "command": "setsid ls",
      "expect": "allow",
      "note": "no wrapper false positives"
    },
    {
      "command": "doas ls",
      "expect": "allow",
      "note": "no wrapper false positives"
    },
    {
      "command": "stdbuf -o0 ls",
      "expect": "allow",
      "note": "attached flag value"
    },
    {
      "command": "env NODE_ENV=test npm test",
      "expect": "allow",
      "note": "env assignments are not programs"
    },
    {
      "command": "eval \"ls\"",
      "expect": "allow",
      "note": "recursing into eval must not gate everything"
    },
    {
      "command": "dash -c \"ls\"",
      "expect": "allow",
      "note": "nor must -c"
    },
    {
      "command": "bash -lc \"npm run build\"",
      "expect": "allow",
      "note": "the payload people actually write"
    },
    {
      "command": "echo \"just a message\"",
      "expect": "allow",
      "note": "quoted text is data"
    },
    {
      "command": "echo forged > {AOS_HOME}/removals.jsonl",
      "expect": "ask",
      "note": "the removals receipt ledger survives purges \u2014 editing it edits the evidence"
    },
    {
      "command": "tee -a {AOS_HOME}/removals.jsonl <<< '{}'",
      "expect": "ask",
      "note": "appending a forged receipt through tee is the same write"
    },
    {
      "command": "sed -i 's/\"purged\":false/\"purged\":true/' {AOS_HOME}/removals.jsonl",
      "expect": "ask",
      "note": "rewriting a receipt in place must not slip past the file gates"
    },
    {
      "command": "echo x > {AOS_HOME}/projects/demo/ingest.json",
      "expect": "ask",
      "note": "ingest watermarks are AOS state \u2014 rewriting them replays or suppresses deltas"
    }
  ],
  "knownLimits": [
    {
      "command": "bash -c \"$(echo {RM_ROOT})\"",
      "expect": "allow",
      "note": "command substitution inside a -c payload: the substitution splits the payload before the shell would run it"
    },
    {
      "command": "CMD=\"{RM_ROOT}\"; eval $CMD",
      "expect": "allow",
      "note": "variable indirection \u2014 the gate does not track variable values"
    },
    {
      "command": "echo '{RM_ROOT}' | bash",
      "expect": "allow",
      "note": "piping a script into a shell: the destructive text is an argument to echo, and bash reads it from stdin"
    },
    {
      "command": "bash <<< \"{RM_ROOT}\"",
      "expect": "allow",
      "note": "herestring feeds the shell from stdin, same shape as the pipe"
    },
    {
      "command": "bash -c \"bash -c \\\"bash -c 'bash -c \\\\\\\"{RM_ROOT}\\\\\\\"'\\\"\"",
      "expect": "allow",
      "note": "nesting deeper than EVAL_DEPTH_MAX (3): the cap is deliberate, a pathological string must not recurse forever"
    },
    {
      "command": "xargs rm -rf < list.txt",
      "expect": "allow",
      "note": "the targets arrive on stdin, so there is nothing in the command to judge"
    }
  ]
}
